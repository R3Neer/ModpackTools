<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LegacyRoot Condition="'$(LegacyRoot)' == ''">../../work/ModpackTools</LegacyRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Tomlyn">
      <HintPath>$(LegacyRoot)/Private/lib/Tomlyn.dll</HintPath>
    </Reference>
    <Compile Include="$(LegacyRoot)/Private/MavenVersion.cs" Link="LegacyMavenVersion.cs" />
  </ItemGroup>
</Project>
